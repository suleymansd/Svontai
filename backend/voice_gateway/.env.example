VOICE_GATEWAY_PUBLIC_URL=https://voice.example.com
SVONTAI_BACKEND_URL=https://api.example.com
VOICE_GATEWAY_TO_SVONTAI_SECRET=replace-with-the-same-strong-secret-as-backend
TWILIO_AUTH_TOKEN=replace-with-the-twilio-auth-token

# Safe default. Set conversation_relay only after Twilio ConversationRelay onboarding is complete.
TWILIO_VOICE_MODE=gather
TWILIO_TTS_VOICE=Google.tr-TR-Wavenet-D
TWILIO_TTS_LANGUAGE=tr-TR
TWILIO_GATHER_SPEECH_MODEL=googlev2_telephony_short
TWILIO_GATHER_SPEECH_TIMEOUT=1
TWILIO_SPEECH_HINTS=randevu,rezervasyon,fiyat,adres,çalışma saatleri,WhatsApp,evet,hayır

# Realtime mode settings.
TWILIO_RELAY_TTS_PROVIDER=Google
TWILIO_RELAY_TTS_VOICE=tr-TR-Wavenet-D
TWILIO_RELAY_TRANSCRIPTION_PROVIDER=Google
TWILIO_RELAY_SPEECH_MODEL=long
TWILIO_RELAY_SPEECH_TIMEOUT_MS=800
TWILIO_RELAY_INTERRUPT_SENSITIVITY=medium
TWILIO_RELAY_WS_TOKEN_TTL_SECONDS=600
