# Runtime
ENVIRONMENT=dev
SERVICE_ROLE=api
DATABASE_URL=sqlite:///./smartwa.db
BACKEND_URL=http://127.0.0.1:8001
FRONTEND_URL=http://127.0.0.1:3000
WEBHOOK_PUBLIC_URL=http://127.0.0.1:8001

# Authentication and encryption (replace every value outside local development)
JWT_SECRET_KEY=change-me-with-at-least-32-random-characters
ENCRYPTION_KEY=
ARTIFACT_SIGNING_SECRET=
WEBHOOK_USERNAME=local-webhook-user
WEBHOOK_PASSWORD=change-me

# AI
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Email
EMAIL_ENABLED=false
EMAIL_PROVIDER=resend
RESEND_API_KEY=
SMTP_FROM_EMAIL=info@example.com
SMTP_FROM_NAME=SvontAI

# WhatsApp QR gateway
OPENWA_ENABLED=false
OPENWA_BASE_URL=
OPENWA_API_KEY=
OPENWA_WEBHOOK_SECRET=
OPENWA_WEBHOOK_PUBLIC_URL=http://127.0.0.1:8001

# Official Meta WhatsApp alternative
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
META_REDIRECT_URI=http://127.0.0.1:8001/api/onboarding/whatsapp/callback

# Automation
USE_N8N=false
N8N_BASE_URL=
N8N_API_KEY=
N8N_INCOMING_WORKFLOW_ID=
SVONTAI_TO_N8N_SECRET=change-me
N8N_TO_SVONTAI_SECRET=change-me
N8N_ERROR_WEBHOOK_SECRET=change-me

# Rate limiting and monitoring
RATE_LIMIT_BACKEND=memory
REDIS_URL=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05

# Private artifacts. Production should use r2 or a Railway volume.
ARTIFACT_STORAGE_PROVIDER=local
ARTIFACT_STORAGE_LOCAL_BASE_PATH=storage/artifacts
ARTIFACT_SIGNED_URL_EXPIRES_SECONDS=300
ARTIFACT_R2_ENDPOINT_URL=
ARTIFACT_R2_ACCESS_KEY_ID=
ARTIFACT_R2_SECRET_ACCESS_KEY=
ARTIFACT_R2_BUCKET=
ARTIFACT_R2_PREFIX=artifacts

# Launch billing model: customers contact sales; no in-app charge.
BILLING_MODE=manual
PAYMENTS_ENABLED=false
SALES_CONTACT_EMAIL=
SALES_CONTACT_URL=

# Voice remains unavailable until a real provider is configured.
VOICE_OUTBOUND_MODE=dry_run
VOICE_OUTBOUND_PROVIDER=twilio
VOICE_GATEWAY_PUBLIC_URL=
VOICE_GATEWAY_TO_SVONTAI_SECRET=change-me
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
