FROM node:22.22.0-alpine AS dependencies

WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

FROM node:22.22.0-alpine AS builder

WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1

ARG NEXT_PUBLIC_BACKEND_URL
ARG NEXT_PUBLIC_SITE_URL
ARG NEXT_PUBLIC_SENTRY_DSN
ARG NEXT_PUBLIC_LEGAL_ENTITY_NAME
ARG NEXT_PUBLIC_LEGAL_ENTITY_ADDRESS
ARG NEXT_PUBLIC_LEGAL_ENTITY_TAX_OFFICE
ARG NEXT_PUBLIC_LEGAL_ENTITY_TAX_NUMBER
ARG NEXT_PUBLIC_LEGAL_ENTITY_MERSIS_NUMBER
ARG NEXT_PUBLIC_LEGAL_ENTITY_TRADE_REGISTRY_NUMBER
ARG NEXT_PUBLIC_LEGAL_ENTITY_KEP_ADDRESS
ARG NEXT_PUBLIC_LEGAL_CONTACT_EMAIL
ARG NEXT_PUBLIC_LEGAL_CONTACT_PHONE

ENV NEXT_PUBLIC_BACKEND_URL=$NEXT_PUBLIC_BACKEND_URL \
    NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL \
    NEXT_PUBLIC_SENTRY_DSN=$NEXT_PUBLIC_SENTRY_DSN \
    NEXT_PUBLIC_LEGAL_ENTITY_NAME=$NEXT_PUBLIC_LEGAL_ENTITY_NAME \
    NEXT_PUBLIC_LEGAL_ENTITY_ADDRESS=$NEXT_PUBLIC_LEGAL_ENTITY_ADDRESS \
    NEXT_PUBLIC_LEGAL_ENTITY_TAX_OFFICE=$NEXT_PUBLIC_LEGAL_ENTITY_TAX_OFFICE \
    NEXT_PUBLIC_LEGAL_ENTITY_TAX_NUMBER=$NEXT_PUBLIC_LEGAL_ENTITY_TAX_NUMBER \
    NEXT_PUBLIC_LEGAL_ENTITY_MERSIS_NUMBER=$NEXT_PUBLIC_LEGAL_ENTITY_MERSIS_NUMBER \
    NEXT_PUBLIC_LEGAL_ENTITY_TRADE_REGISTRY_NUMBER=$NEXT_PUBLIC_LEGAL_ENTITY_TRADE_REGISTRY_NUMBER \
    NEXT_PUBLIC_LEGAL_ENTITY_KEP_ADDRESS=$NEXT_PUBLIC_LEGAL_ENTITY_KEP_ADDRESS \
    NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=$NEXT_PUBLIC_LEGAL_CONTACT_EMAIL \
    NEXT_PUBLIC_LEGAL_CONTACT_PHONE=$NEXT_PUBLIC_LEGAL_CONTACT_PHONE

COPY --from=dependencies /app/node_modules ./node_modules
COPY frontend ./
RUN npm run build

FROM node:22.22.0-alpine AS runner

WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    HOSTNAME=0.0.0.0 \
    PORT=3000

RUN addgroup --system --gid 10001 svontai \
    && adduser --system --uid 10001 --ingroup svontai svontai

COPY --from=builder --chown=svontai:svontai /app/public ./public
COPY --from=builder --chown=svontai:svontai /app/.next/standalone ./
COPY --from=builder --chown=svontai:svontai /app/.next/static ./.next/static

USER svontai
EXPOSE 3000
CMD ["node", "server.js"]
